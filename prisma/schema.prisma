// Joyería Edra — esquema de autenticación
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ASESOR
  CLIENTE
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          Role      @default(CLIENTE)
  active        Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tokens        Token[]
  clientProfile ClientProfile?
  orders        Order[]        @relation("ClientOrders")
  advisedOrders Order[]        @relation("AdvisorOrders")
  notifications Notification[]

  @@map("users")
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String // destinatario
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ───────────────── Flujo del cliente (registro por pasos) ─────────────────

enum DocumentType {
  CEDULA_CIUDADANIA
  CEDULA_EXTRANJERIA
  PASAPORTE
}

enum ContactMedium {
  REFERENCIA
  RED_SOCIAL
  PAGINA_WEB
  BUSCADOR_WEB
}

enum SocialNetwork {
  FACEBOOK
  X
  INSTAGRAM
  LINKEDIN
}

// Paso 2: Datos personales (a cargo del Cliente)
model ClientProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Facturación / contacto (nullable: se guardan como borrador a medida que avanza)
  documentType   DocumentType?
  documentNumber String?
  whatsapp       String?
  contactMedium  ContactMedium?
  socialNetwork  SocialNetwork? // condicional (si contactMedium = RED_SOCIAL)
  socialLink     String?

  // Envío
  shippingCountry String?
  cityState       String?
  postalCode      String? // obligatorio solo si el país de envío no es Colombia
  address         String?
  neighborhood    String? // barrio
  addressDetails  String? // conjunto, torre, apto u otras indicaciones

  privacyAccepted Boolean @default(false)

  // Estado del registro por pasos
  completed Boolean @default(false)
  lastStep  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_profiles")
}

enum Product {
  ARGOLLAS
  ANILLOS
  SET_MATRIMONIAL
  CINTILLO
  CADENA
  PULSERA
  TOPOS
  CANDONGAS
  DIJE
  PERSONALIZADO
}

enum Material {
  ORO_10K
  ORO_14K
  ORO_18K
  ORO_18K_PLATA // Oro 18k + plata
  PLATA_925
  PLATA_950
  PLATINO_950
}

enum GemType {
  DIAMANTE_NATURAL
  DIAMANTE_LABORATORIO
  ESMERALDA
  ZAFIRO
  RUBI
  TANZANITA
  TURMALINA
  AGUAMARINA
  AMATISTA
  TOPACIO
  CITRINO
  PERIDOTO
  GRANATE
  MOISSANITA
  ZIRCON_SUIZO_SINTETICO
  OTRA
  SIN_PIEDRA
}

// Estados del flujo de fabricación (en orden).
enum OrderStatus {
  EN_TRAMITE
  EN_FABRICACION
  ENGASTE
  NOVEDAD_FABRICACION
  FINALIZADO
  ENTREGADO
  DESISTIDO
}

enum DeliveryType {
  ENVIO_INTERNACIONAL
  ENVIO_NACIONAL
  ENVIO_BOGOTA
  RECOGER_EN_TIENDA
}

enum PaymentMethod {
  TARJETA_CREDITO
  TARJETA_DEBITO
  ADDI
  SISTECREDITO
  TRANSFERENCIA
  EFECTIVO
}

// Facturación electrónica: con FE o sin FE.
enum InvoiceType {
  CON_FE
  SIN_FE
}

// Producto dentro de una orden. Una compra puede incluir varios productos:
// los datos que dependen del producto (los del cliente y los técnicos del
// asesor) viven aquí; los datos finales de la compra viven en `Order`.
model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int    @default(0) // orden de aparición dentro de la compra

  // Campos diligenciados por el Cliente (varían según el producto)
  product            Product? // nullable: borrador
  size               String? // talla (anillo)
  sizeLady           String? // talla dama
  sizeGentleman      String? // talla caballero
  material           Material?
  gemType            GemType?
  gemOther           String? // gema escrita por el cliente (si gemType = OTRA)
  engraving          String? // grabado (máx. 25)
  engravingLady      String? // grabado argolla dama
  engravingGentleman String? // grabado argolla caballero
  fontType           String? // tipo de fuente

  // Campos diligenciados por el Asesor (varían según el producto)
  weightApprox       String? // peso aprox. (cadena)
  weightLady         String? // peso aprox. dama (argollas)
  weightGentleman    String? // peso aprox. caballero (argollas)
  widthLady          String? // ancho aprox. dama (argollas/set)
  widthGentleman     String? // ancho aprox. caballero (argollas/set)
  model              String? // modelo
  weaveType          String? // tipo de tejido (cadena)
  length             String? // largo (cadena/pulsera)
  productName        String? // nombre del producto (personalizado)
  productDescription String? // tipo de producto (personalizado)
  gemNotes           String? // observación sobre las gemas
  finalDescription   String? // descripción del producto (solo asesor)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}

// Paso 3: Orden de trabajo (una compra, uno o varios productos)
model Order {
  id     String @id @default(cuid())
  // Número visible para el cliente (consecutivo).
  number Int    @unique @default(autoincrement())

  // Cliente dueño de la orden
  userId String
  user   User   @relation("ClientOrders", fields: [userId], references: [id], onDelete: Cascade)

  // Asesor asignado (lo asigna el módulo de asesores)
  advisorId String?
  advisor   User?   @relation("AdvisorOrders", fields: [advisorId], references: [id], onDelete: SetNull)

  // Código de orden de trabajo asignado por el Asesor (Paso 4)
  workOrderCode String?

  // Productos de la compra (campos del cliente + técnicos del asesor)
  items OrderItem[]

  // Observaciones de fabricación: iguales para toda la compra
  manufacturingNotes String?

  // Paso 4 — Datos finales (diligenciados por el Asesor). Valores en pesos (Int).
  saleDate            DateTime? // fecha de venta
  jewelerDeliveryDate DateTime? // fecha de entrega del joyero
  deliveryFrom        DateTime? // fecha de entrega/envío (desde)
  deliveryTo          DateTime? // fecha de entrega/envío (hasta)
  purchaseValue       Int? // valor compra
  depositValue        Int? // valor abono
  deliveryType        DeliveryType? // tipo de entrega
  shippingValue       Int? // valor envío
  balanceWithShipping Int? // saldo con envío = compra - abono + envío (calculado)
  paymentMethod       PaymentMethod? // método de pago
  invoiceType         InvoiceType? // con FE / sin FE
  jeweler             String? // joyero fabricante
  systemEntry         String? // ingreso al sistema
  internalNotes       String? // notas adicionales (uso interno)

  // Comprobante de abono (archivo adjunto guardado en la BD)
  depositReceiptName String? // nombre original del archivo
  depositReceiptType String? // MIME type
  depositReceiptSize Int? // tamaño en bytes
  depositReceiptData Bytes? // contenido del archivo

  status OrderStatus @default(EN_TRAMITE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([advisorId])
  @@map("orders")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_INVITE
}

model Token {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  expires   DateTime
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tokens")
}
