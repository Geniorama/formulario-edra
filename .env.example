# ─────────────────────────────────────────────────────────────
#  Joyería Edra — variables de entorno
#  Copia este archivo a `.env` y completa los valores reales.
#  NO escribas credenciales reales aquí: este archivo se versiona en git.
# ─────────────────────────────────────────────────────────────

# ── Base de datos: Supabase (Postgres) ───────────────────────
# DATABASE_URL  -> conexión "pooled" (PgBouncer, puerto 6543). La usa la app.
# DIRECT_URL    -> conexión directa (puerto 5432). La usan las migraciones.
# En Supabase: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── NextAuth / Auth.js ───────────────────────────────────────
# Genera el secreto con:  npx auth secret   (o)  openssl rand -base64 32
AUTH_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"
# URL pública de la aplicación (sin slash final).
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Correo: ZeptoMail (API, no SMTP) ─────────────────────────
# Panel ZeptoMail > Mail Agents > tu agente > SMTP/API > "Send Mail Token".
# Pega el token tal cual (con o sin el prefijo "Zoho-enczapikey ").
ZEPTOMAIL_TOKEN="Zoho-enczapikey TU_SEND_MAIL_TOKEN"
# Endpoint regional: api.zeptomail.com (global) o api.zeptomail.eu (Europa).
ZEPTOMAIL_URL="https://api.zeptomail.com/v1.1/email"
# Remitente (debe ser un dominio/dirección verificada en ZeptoMail).
ZEPTOMAIL_FROM="no-responder@joyeriaedra.com"
ZEPTOMAIL_FROM_NAME="Joyería Edra"
